# Copy these values into:
# %LOCALAPPDATA%\xauusd_signal_lab\mochipoyo_alert_research\.env
#
# Never commit the real token.
MOCHIPOYO_EVENTS_URL=https://YOUR_WORKER.workers.dev/events
MOCHIPOYO_READ_TOKEN=REPLACE_WITH_LOCAL_SECRET

# Optional override. Leave empty to use the default LOCALAPPDATA path.
MOCHIPOYO_LOCAL_ROOT=
