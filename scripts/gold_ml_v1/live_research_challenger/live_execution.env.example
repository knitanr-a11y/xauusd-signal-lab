# Copy only the required keys into MT5 MQL5\Files\.env.
# Never commit the real webhook, account password, or login.
# Discord delivery and the MT5 execution service are always requested while
# run_live_loop.bat is running. There are no normal ON/OFF switches.

# Discord: any one of the supported webhook keys is accepted.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME
GML1_DISCORD_USERNAME=GML1 XAUUSD

# Execution mode remains fail-closed. Keep dry-run until Windows/MT5 verification.
GML1_MT5_DRY_RUN=true
GML1_MT5_SYMBOL=XAUUSD

# Set either one global volume or all four sleeve-specific volumes.
# GML1_MT5_VOLUME=0.01
GML1_MT5_VOLUME_A_CORE=0.01
GML1_MT5_VOLUME_B_STATE=0.01
GML1_MT5_VOLUME_P18=0.01
GML1_MT5_VOLUME_W024A=0.01

# Risk and order controls.
GML1_MT5_MAX_TOTAL_POSITIONS=1
GML1_MT5_MAX_ENTRY_LAG_SECONDS=180
GML1_MT5_DEVIATION_POINTS=50
GML1_MT5_FILLING_MODE=AUTO
GML1_MT5_REQUIRE_HEDGING=true

# Usually unnecessary when the intended terminal is already open and logged in.
# GML1_MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# GML1_MT5_LOGIN=12345678
# GML1_MT5_PASSWORD=REPLACE_ME
# GML1_MT5_SERVER=Broker-Server

# Discord shows only the realized live MT5 win rate for each sleeve.
# Historical replay results are not read, displayed, or used as an order gate.

# Short-lived notification/runtime logs are retained for 31 days.
# Closed real trades are permanently archived by month under outputs/.../trades/.

# Real-order mode is a one-time operating-mode setting, not a routine ON/OFF switch.
# Do not enable before dry-run verification.
# GML1_MT5_DRY_RUN=false
# GML1_MT5_LIVE_CONFIRM=I_UNDERSTAND_THIS_SENDS_REAL_MT5_ORDERS
